NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=

# Facebook Graph API. Reading Pages the agency does not administer needs
# Page Public Content Access, granted through App Review + Business Verification.
# A short-lived Graph API Explorer token is enough to test whether access works.
FACEBOOK_ACCESS_TOKEN=
# Optional. Left blank, calls go unversioned and Meta applies the app default,
# which avoids pinning a Graph version that has since expired.
FACEBOOK_API_VERSION=
